# Base URL of the NestJS API (see appoitment-backend/API.md).
# Server-side code (route handlers, proxy.ts, server components) prefers API_URL;
# the browser (Socket.IO origin) uses NEXT_PUBLIC_API_URL.
API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional: Socket.IO origin when it differs from NEXT_PUBLIC_API_URL without "/api".
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Optional: display currency (default PKR).
# NEXT_PUBLIC_CURRENCY=PKR

# Note: the API defaults to port 3000, so run this app on another port, e.g. `npx next dev -p 3001`.
